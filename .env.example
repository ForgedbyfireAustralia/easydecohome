# Copy to .env for `npx netlify dev`. Never commit .env. On Netlify, set these in Site settings > Environment variables.
AIRWALLEX_ENV=demo
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
# Order emails via Resend (optional; orders are still marked paid without them)
RESEND_API_KEY=
ORDER_FROM_EMAIL=Easy Deco Home <orders@easydecohome.com.au>
ORDER_EMAIL=
